<!-- Container -->
<section class="container">

  <ul id="productos" class="listprod">
    <!-- Listado de productos -->
  </ul>

  <!-- Formulario ingresar producto nuevo -->
  <form id="form" class="formprod" enctype="multipart/form-data" action="/realtimeproducts" method="post">

    <label for="title">Título</label>
    <input id="title" type="text" name="title" />

    <label for="description">Descripción</label>
    <input id="description" type="text" name="description" />

    <label for="code">Código</label>
    <input id="code" type="text" name="code" />

    <label for="price">Precio</label>
    <input id="price" type="text" name="price" />

    <label for="status">Estado</label>
    <input id="status" type="text" name="status" />

    <label for="stock">Stock</label>
    <input id="stock" type="text" name="stock" />

    <label for="category">Categoría</label>
    <input id="category" type="text" name="category" />

    <label for="image">Imagen</label>
    <input id="image" type="file" name="image" />

    <input type="submit" value="Agregar producto" />
  </form>
</section>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script type="module" src="/js/index.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  .container { display: grid; grid-template-columns: 60% 40%; justify-content:
  center; align-items: start; gap: 1rem; padding: 2rem 0; width: 100%;
  min-height: 90dvh; } .listprod { display: flex; flex-direction: column; }
  .formprod { display: flex; flex-direction: column; align-items: start;
  justify-content: center; gap: .3rem; } .formprod li { display: flex;
  align-items: center; justify-content: start; gap: .5rem; } .formprod label {
  font-size: 16px; } .formprod input { }
</style>